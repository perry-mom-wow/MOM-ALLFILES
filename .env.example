# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily (web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Maps Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# HubSpot
HUBSPOT_API_KEY=your_hubspot_private_app_token_here
HUBSPOT_PIPELINE_ID=default   # set after creating the pipeline in HubSpot

# Email reports (choose one)
SENDGRID_API_KEY=your_sendgrid_api_key_here
REPORT_FROM_EMAIL=reports@mom-wow.com

# Report recipients (comma-separated)
REPORT_RECIPIENTS=perry@mom-wow.com,marcus@mom-wow.com,laura@mom-wow.com

# ── EA system (Phase 1) ───────────────────────────────────────────────────────

# Postgres (Supabase free tier). Leave empty to use local SQLite at data/ea.db.
DATABASE_URL=

# Dry-run mode: if "true", run_daily.py reads sources but writes nothing back.
DRY_RUN=true

# Google OAuth (one set of creds covers Gmail, Calendar, Drive, Sheets).
# Bootstrap: run `python -m connectors._google_auth setup` to obtain the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Granola — meeting notes API.
GRANOLA_API_KEY=
GRANOLA_BASE_URL=https://api.granola.ai/v1

# Notion — internal integration token. Share Brain Dump + Wiki pages with the integration.
NOTION_TOKEN=
NOTION_BRAIN_DUMP_PAGE_ID=357cbc790b02811f98c7e476ee0fa538
NOTION_WIKI_PAGE_ID=357cbc790b02813391e9e44b89c22f95
